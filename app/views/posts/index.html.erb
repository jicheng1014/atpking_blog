<% content_for :title, (@article_index ? '文章 · ATPKING' : 'ATPKING · 随想与文章') %>
<div class="<%= @article_index ? 'max-w-2xl mx-auto px-4 sm:px-6 py-10' : 'home-page' %>">
  <% unless @article_index %>
    <header class="home-intro" id="about">
      <div class="home-identity">
        <div class="home-avatar" aria-hidden="true">A</div>
        <div>
          <h1>ATPKING</h1>
          <p>写代码，做产品，也记录日常的想法。</p>
        </div>
      </div>
      <div class="home-projects" id="projects" aria-label="个人项目">
        <span>在做：</span>
        <%= link_to 'OK Uptime ↗', 'https://www.okuptime.com/', target: '_blank', rel: 'noopener noreferrer' %>
        <%= link_to '毛驴短链 ↗', 'https://www.maolvdl.com/', target: '_blank', rel: 'noopener noreferrer' %>
        <%= link_to 'Pocket Board ↗', 'https://pocketboard.okuptime.com/zh', target: '_blank', rel: 'noopener noreferrer' %>
        <%= link_to 'Git Knock ↗', 'https://gitknock.okuptime.com/', target: '_blank', rel: 'noopener noreferrer' %>
      </div>
    </header>

    <div class="home-columns">
      <section class="home-thoughts" id="thoughts" aria-labelledby="thoughts-title">
        <div class="home-section-heading">
          <h2 id="thoughts-title">随想</h2>
          <%= link_to '全部随想 →', thoughts_path %>
        </div>

        <div class="home-rhythm" aria-labelledby="rhythm-title">
          <div class="home-rhythm-heading">
            <h3 id="rhythm-title">本月发布节奏</h3>
            <span><%= @rhythm_month.strftime('%Y年%-m月') %> · 随想 / 日</span>
          </div>
          <% max_count = [@rhythm_counts.values.max.to_i, 1].max %>
          <div class="home-rhythm-days" style="--days: <%= @rhythm_month.end_of_month.day %>" role="img" aria-label="<%= @rhythm_month.strftime('%Y年%-m月') %>每天已发布随想数量：<%= @rhythm_counts.sort.map { |day, count| "#{day}日#{count}条" }.join('，').presence || '暂无发布' %>；其余已过去日期为零条">
            <% (1..@rhythm_month.end_of_month.day).each do |day| %>
              <% count = @rhythm_counts.fetch(day, 0) %>
              <% future = @rhythm_month.change(day: day) > Date.current %>
              <div class="home-rhythm-day <%= future ? 'is-future' : count.zero? ? 'is-empty' : 'has-posts' %>" aria-hidden="true" title="<%= day %>日 · <%= future ? '未到' : "#{count}条" %>">
                <span class="home-rhythm-count"><%= count if count.positive? %></span>
                <span class="home-rhythm-mark" style="--bar-height: <%= count.positive? ? 7 + (count * 33.0 / max_count).round : 0 %>px"></span>
                <span class="home-rhythm-label"><%= day if day == 1 || day % 5 == 0 || day == @rhythm_month.end_of_month.day %></span>
              </div>
            <% end %>
          </div>
          <p class="home-rhythm-note"><span>本月 <%= @rhythm_counts.values.sum %> 条随想</span><span>灰点为 0 条 · 空心点为未来日期 · 仅统计已发布随想</span></p>
        </div>

        <% if current_user %>
          <%= render 'thoughts/quick_post_form', thought: Thought.new, redirect_to_path: root_path %>
        <% end %>

        <% if @recent_thoughts.empty? %>
          <p class="home-empty">暂无随想</p>
        <% else %>
          <div class="home-thought-feed">
            <% @recent_thoughts.each do |thought| %>
              <article class="home-thought">
                <div class="home-thought-meta">
                  <span class="home-mini-avatar" aria-hidden="true">A</span>
                  <span>ATPKING</span>
                  <span aria-hidden="true">·</span>
                  <time datetime="<%= thought.publication_time.iso8601 %>">
                    <%= link_to thought.publication_time.in_time_zone.strftime('%-m月%-d日 %H:%M'), thought_path(thought) %>
                  </time>
                </div>
                <div class="home-thought-content prose prose-stone max-w-none">
                  <%= raw thought.rendered_content %>
                </div>
              </article>
            <% end %>
          </div>
        <% end %>

      </section>

      <section class="home-articles" id="articles" aria-labelledby="articles-title">
        <div class="home-section-heading">
          <h2 id="articles-title">文章</h2>
          <%= link_to '全部文章 →', posts_path %>
        </div>
  <% end %>

  <% if @tag %>
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-base font-medium text-stone-700"><span class="text-stone-400 font-normal">标签 /</span> <%= @tag.name %></h1>
      <%= link_to '← 全部文章', root_path(anchor: 'articles'), class: 'text-xs text-stone-400 hover:text-stone-600' %>
    </div>
  <% end %>
  <% if @article_index && @tag.nil? %>
    <h1 class="text-2xl font-bold text-stone-900 mb-6">文章</h1>
  <% end %>

  <% if @posts.empty? %>
    <p class="home-empty">暂无文章</p>
  <% else %>
    <% if @article_index %>
      <% @posts.group_by { |post| post.created_at.year }.each do |year, year_posts| %>
        <div class="flex items-center gap-3 mb-2 mt-8 first:mt-0">
          <span class="text-xs font-medium text-stone-400 tabular-nums"><%= year %></span>
          <div class="flex-1 h-px bg-stone-200"></div>
        </div>
        <% year_posts.each do |post| %>
          <%= render 'article_preview', post: post %>
        <% end %>
      <% end %>
    <% else %>
      <% @posts.each do |post| %>
        <%= render 'article_preview', post: post %>
      <% end %>
    <% end %>

    <% if @article_index && @pagy.pages > 1 %>
      <nav class="home-pagination" aria-label="文章分页">
        <%= link_to '← 上一页', url_for(page: @pagy.prev), class: 'home-page-link' if @pagy.prev %>
        <span><%= @pagy.page %> / <%= @pagy.pages %></span>
        <%= link_to '下一页 →', url_for(page: @pagy.next), class: 'home-page-link' if @pagy.next %>
      </nav>
    <% end %>
  <% end %>

  <% unless @article_index %>
      </section>
    </div>
  <% end %>
</div>
